        .delay-200 { transition-delay: 200ms; }
        .delay-300 { transition-delay: 300ms; }

        /* Image Hover Effect */
        .img-zoom-container {
            overflow: hidden;
        }
        .img-zoom {
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .group:hover .img-zoom {
            transform: scale(1.05);
        }
    </style>
</head>
